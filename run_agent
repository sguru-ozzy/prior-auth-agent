#!/bin/sh
set -eu

agent_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
agent_python="$agent_root/.venv/bin/python"

if [ ! -x "$agent_python" ]; then
    printf '%s\n' 'Agent environment is missing. Run uv sync --locked from the repository directory.' >&2
    exit 2
fi

exec "$agent_python" -m prior_auth_agent "$@"
