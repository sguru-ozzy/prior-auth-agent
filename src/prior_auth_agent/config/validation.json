{
  "version": "section-4-v1",
  "max_input_bytes": 1048576,
  "name_punctuation": "-' ",
  "name_fields": [
    "patient.first_name",
    "patient.last_name"
  ],
  "nonblank_fields": [
    "coverage.bin",
    "coverage.pcn",
    "coverage.group",
    "prescriber.npi",
    "medication.name",
    "medication.package",
    "clinical.diagnosis_icd10",
    "attestation_name"
  ],
  "patterns": {
    "patient.member_id": {
      "pattern": "ZZ3[0-9]{5}",
      "problem": "Expected ZZ3 followed by five digits."
    },
    "patient.state": {
      "pattern": "[A-Za-z]{2}",
      "problem": "Expected a two-letter state."
    },
    "patient.zip_code": {
      "pattern": "[0-9]{5}",
      "problem": "Expected a five-digit ZIP code."
    },
    "prescriber.npi": {
      "pattern": "[0-9]{10}",
      "problem": "Expected a ten-digit NPI."
    },
    "clinical.diagnosis_icd10": {
      "pattern": "[A-Za-z][0-9]{2}(?:\\.[A-Za-z0-9]{1,4})?",
      "problem": "Expected the ICD-10 format specified in Section 4."
    }
  },
  "choices": {
    "patient.sex": [
      "M",
      "F",
      "X"
    ],
    "clinical.site_of_care": [
      "Home",
      "Clinic"
    ]
  },
  "ranges": {
    "clinical.body_surface_area_percent": {
      "minimum": 0,
      "maximum": 100
    },
    "clinical.quantity_per_28_days": {
      "minimum": 1,
      "maximum": 12
    }
  },
  "date_fields": [
    "patient.date_of_birth",
    "clinical.current_therapy_start_date"
  ],
  "date_pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}",
  "minimum_age": 0,
  "maximum_age": 120,
  "required_when": [
    {
      "when_field": "clinical.new_start",
      "equals": false,
      "required_field": "clinical.current_therapy_start_date",
      "problem": "A current therapy start date is required when new_start is false."
    }
  ]
}
